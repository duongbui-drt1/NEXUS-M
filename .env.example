# Copy to .env (gitignored, chmod 600) for local development. NEVER commit real secrets.
ConnectionStrings__Default=Host=localhost;Port=5432;Database=nexus_m_local_sandbox;Username=nexus_m_app;Password=nexus_m_local_dev_pw
ConnectionStrings__Migrator=Host=localhost;Port=5432;Database=nexus_m_local_sandbox
Jwt__Issuer=nexus-c
Jwt__Audience=nexus-ecosystem
Jwt__SigningKey=REPLACE_WITH_SHARED_NEXUS_C_JWT_SIGNING_KEY_MIN_32_CHARS
NexusCore__BaseUrl=http://localhost:5000
NexusCore__ClientId=nexus-m-service
NexusCore__ClientSecret=REPLACE_WITH_NEXUS_C_SERVICE_CLIENT_SECRET
